# J.A.R.V.I.S. Nexus — environment configuration
# Copy this file to `.env` and fill in values. `.env` is git-ignored.

# OPTIONAL: enables LLM-powered chat explanations.
# Without it, the deterministic template assistant is used (demo never breaks).
OPENAI_API_KEY=

# Optional: override the LLM model (default gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Optional: SQLite database location (default: nexus.db in backend/)
NEXUS_DB=nexus.db
